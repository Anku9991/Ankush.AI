# Ankush.AI Environment Configuration

# Server Settings
PORT=3001
NODE_ENV=development

# Security
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,https://pihnexa.co.in

# Email Settings (Gmail)
# 1. Go to Google Account -> Security -> 2-Step Verification
# 2. Scroll to bottom -> App Passwords
# 3. Create a new "Mail" password for your server
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Notification Recipient
NOTIFY_EMAIL=info@pihnexa.co.in

# ─── Google SEO & Verification ───────────────────────────────────────────────
# Google Search Console verification code
# Get from: https://search.google.com/search-console
# Format: just the code part (e.g. abcdef1234567890)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code-here

# Instagram Access Token (for Instagram feed)
# Get from: Meta Developer Console
IG_ACCESS_TOKEN=your-instagram-access-token

# Google Business Profile Review Link
# Get from: Google Business Profile dashboard -> Get more reviews
# Format: https://g.page/r/XXXXXXXXXX/review
NEXT_PUBLIC_GOOGLE_REVIEW_LINK=https://g.page/r/YOUR_PLACE_ID/review
